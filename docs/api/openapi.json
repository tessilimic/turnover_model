          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "prédiction"
        ],
        "summary": "Prédire le départ d'un employé",
        "description": "Estime la probabilité de départ d'un employé et enregistre la prédiction.\n\nRéservé aux rôles **rh** et **admin**.\n\n- **probabilite_depart** : probabilité estimée par le modèle (0 à 1).\n- **depart_predit** : `true` si la probabilité atteint le seuil (0,41).\n  Ce seuil privilégie la détection des départs : environ 8 départs réels\n  sur 10 sont signalés, au prix de fausses alertes (≈ 3 alertes sur 10 justifiées).\n- Les entrées sont stockées dans la table `employes`, le résultat dans\n  `predictions` (identifiant renvoyé dans **id_prediction**).",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Prédiction calculée et enregistrée.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOutput"
                },
                "example": {
                  "id_prediction": 1471,
                  "probabilite_depart": 0.6367,
                  "seuil": 0.41,
                  "depart_predit": true
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié : jeton absent, invalide ou expiré."
          },
          "403": {
            "description": "Rôle insuffisant pour cette action."
          },
          "422": {
            "description": "Entrée invalide (champ manquant, valeur hors liste ou hors bornes, champ inconnu). Rien n'est enregistré.",
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "type": "literal_error",
                      "loc": [
                        "body",
                        "poste"
                      ],
                      "msg": "Input should be 'Assistant de Direction', 'Cadre Commercial', ...",
                      "input": "Astronaute"
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    }
  },
