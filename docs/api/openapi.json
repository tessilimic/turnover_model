    "/token": {
      "post": {
        "tags": [
          "authentification"
        ],
        "summary": "Se connecter (obtenir un jeton)",
        "description": "Échange un identifiant et un mot de passe contre un jeton JWT.\n\nLe jeton est valable 30 minutes (par défaut) et s'envoie dans l'en-tête\n`Authorization: Bearer <jeton>`. Après 5 échecs, le compte est verrouillé\n15 minutes.",
        "operationId": "connexion_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_connexion_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jeton"
                }
              }
            }
          },
          "401": {
            "description": "Identifiant ou mot de passe incorrect, ou compte désactivé ou verrouillé (raison non précisée)."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/moi": {
      "get": {
        "tags": [
          "authentification"
        ],
