              "minimum": 0,
              "description": "Lignes à sauter (pagination)",
              "default": 0,
              "title": "Offset"
            },
            "description": "Lignes à sauter (pagination)"
          },
          {
            "name": "code_http",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ex. 200, 422",
              "title": "Code Http"
            },
            "description": "Ex. 200, 422"
          },
          {
            "name": "request_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Une requête précise",
              "title": "Request Id"
            },
            "description": "Une requête précise"
          },
          {
            "name": "depuis",
