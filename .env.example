# Secrets de l'environnement local.
#   1. Copier ce fichier en .env (jamais versionné : il est dans .gitignore).
#   2. Remplacer CHAQUE valeur "a-remplacer" par une valeur aléatoire :
#        python -c "import secrets; print(secrets.token_urlsafe(32))"
#      (caractères sûrs dans une URL : pas besoin d'échappement dans les adresses ci-dessous)
# Lu par docker compose et par l'application (python-dotenv). Voir docs/securite.md.

# --- PostgreSQL : compte propriétaire (administration uniquement) ---
POSTGRES_USER=turnover
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=turnover

# --- Rôles applicatifs à privilèges minimaux (créés par python -m src.db.init_db) ---
TURNOVER_API_DB_PASSWORD=a-remplacer
TURNOVER_ML_DB_PASSWORD=a-remplacer
TURNOVER_AUDITEUR_DB_PASSWORD=a-remplacer

# --- Adresses de connexion depuis la machine (port 5433) ---
ADMIN_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}
ML_DATABASE_URL=postgresql+psycopg://turnover_ml:${TURNOVER_ML_DB_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}
DATABASE_URL=postgresql+psycopg://turnover_api:${TURNOVER_API_DB_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}

# --- Jetons d'authentification de l'API (32 caractères minimum) ---
JWT_SECRET=a-remplacer
JWT_DUREE_MINUTES=30
